APP_ENV=local
POSTGRES_DB=erp
POSTGRES_USER=erp
POSTGRES_PASSWORD=erp_local_only
POSTGRES_VOLUME_NAME=erp-assistant-demo_postgres_data
REDIS_VOLUME_NAME=erp-assistant-demo_redis_data
MODEL_CACHE_VOLUME_NAME=erp-assistant-demo_model_cache
DATABASE_URL=postgresql+psycopg://erp:erp_local_only@postgres:5432/erp
REDIS_URL=redis://redis:6379/0
JWT_SECRET_KEY=replace-with-a-long-random-secret-before-any-shared-deployment
JWT_ACCESS_TOKEN_MINUTES=60
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-local-demo-password
ADMIN_EMAIL=admin@example.test
LOW_STOCK_THRESHOLD=10
AI_PROVIDER=rules
LLM_BASE_URL=http://model-server:8080/v1
LLM_API_KEY=local-no-auth
LLM_MODEL=MiniCPM5-2B
LLM_MODEL_REPO=openbmb/MiniCPM5-2B-GGUF:Q4_K_M
LLM_CONTEXT_SIZE=4096
LLM_TIMEOUT_SECONDS=60
